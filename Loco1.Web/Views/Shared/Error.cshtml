@using Loco1.Localizer
@using Loco1.ViewModels

@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model ErrorViewModel

@{
    ViewData["Title"] = L["Error_Title"];
    }

<h1 class="text-danger">@L["Error_Title"]</h1>
<h2 class="text-danger">@L["Error_Message"]</h2>

@if (Model.ShowRequestId)
    {
    <p>
        <strong>@L["Error_RequestId"]:</strong>
        <code>@Model.RequestId</code>
    </p>
    }