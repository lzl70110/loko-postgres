@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">

    <!-- Icon -->
    <i class="bi bi-tools" style="font-size: 64px; color: #6c757d;"></i>

    <!-- Title -->
        <h3 class="mt-3 mb-2" style="font-weight: 600;">
        @L["Page_InDevelopment_Title"]
        </h3>

    <!-- Description -->
        <p class="text-muted text-center" style="max-width: 360px;">
        @L["Page_InDevelopment_Description"]
        </p>

    </div>