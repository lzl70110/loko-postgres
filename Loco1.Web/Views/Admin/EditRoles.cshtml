@model Loco1.ViewModels.Roles.EditUserRolesVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using System.Text.Json

@{
    ViewData["Title"] = L["EditRolesTitle"];
    var currentRole = Model.SelectedRoles?.FirstOrDefault() ?? "";
    var jsData = JsonSerializer.Serialize(new
    {
        currentRole = currentRole ?? "",
        confirm = L["ConfirmRoleChange"]?.Value ?? "",
        from = L["From"]?.Value ?? "",
        to = L["To"]?.Value ?? "",
        select = L["PleaseSelectRole"]?.Value ?? "",
        ownerLocked = L["OwnerCannotBeChanged"]?.Value ?? "",
        ownerKey = Model.OwnerRoleName // string, e.g., "Owner"
    });
}

<h2>@L["EditRolesTitle"]</h2>
<p><strong>@L["User"]:</strong> @Model.Email</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form id="edit-roles-form" asp-controller="Admin" asp-action="EditRoles" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="UserId" type="hidden" />

    <div class="mb-3">
        <label class="form-label">@L["Roles"]</label>
        <div class="row">
            @foreach (var role in Model.AvailableRoles ?? Enumerable.Empty<string>())
            {
                var isChecked = Model.SelectedRoles?.Contains(role) == true;
                var isOwner = string.Equals(role, Model.OwnerRoleName, StringComparison.OrdinalIgnoreCase);
                var roleId = $"role_{role.Replace(" ", "_")}";
                var loc = L[$"Role.{role}"];
                var roleLabel = loc.ResourceNotFound ? role : loc.Value;

                <div class="col-12 col-md-6 mb-2">
                    <div class="form-check">
                        <input id="@roleId"
                               class="form-check-input"
                               type="radio"
                               name="SelectedRoles"
                               value="@role"
                               @(isChecked ? "checked" : null)
                               @(isOwner && !isChecked ? "disabled" : null) />
                        <label class="form-check-label" for="@roleId">@roleLabel</label>

                        @if (isOwner && isChecked)
                        {
                            <small class="text-muted ms-2">@L["OwnerCannotBeChanged"]</small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Save"]</button>
        <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">@L["Back"]</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("edit-roles-form");
            if (!form) return;

            const data = @Html.Raw(jsData);
            const modalEl = document.getElementById("confirmRoleChangeModal");
            const modal = modalEl ? new bootstrap.Modal(modalEl) : null;
            const textEl = document.getElementById("confirmRoleChangeText");
            const okBtn = document.getElementById("confirmRoleChangeOkBtn");

            let confirmed = false;

            form.addEventListener("submit", function (e) {
                if (confirmed) { confirmed = false; return; }

                const selected = form.querySelector("input[name='SelectedRoles']:checked");
                if (!selected) { e.preventDefault(); alert(data.select); return; }

                const newRole = selected.value;
                const ownerKey = data.ownerKey;

                if (data.currentRole?.toLowerCase() === ownerKey.toLowerCase() && newRole.toLowerCase() !== ownerKey.toLowerCase()) {
                    e.preventDefault();
                    alert(data.ownerLocked);
                    return;
                }

                if (data.currentRole?.toLowerCase() === newRole.toLowerCase()) return;

                if (modal && textEl) {
                    e.preventDefault();
                    textEl.textContent = `${data.confirm}\n\n${data.from}: ${data.currentRole || "-"}\n${data.to}: ${newRole}`;
                    modal.show();
                }
            });

            if (okBtn && modal) {
                okBtn.addEventListener("click", function () {
                    confirmed = true;
                    modal.hide();
                    form.submit();
                });
            }
        })();
    </script>
}