@using Loco1.Data.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using GCommon
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject SignInManager<ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Auth

@{
    // Пермишън гардове
    var canViewUsers = (await Auth.AuthorizeAsync(User, Perm.Users_View)).Succeeded;
    var canViewLoco = (await Auth.AuthorizeAsync(User, Perm.Loco_View)).Succeeded;
    var canViewRoles = (await Auth.AuthorizeAsync(User, Perm.Roles_View)).Succeeded;

    // Има ли изобщо какво да показваме в Admin групата?
    var showAdminGroup = canViewUsers || canViewLoco || canViewRoles;
}

@* ===================== Admin ===================== *@
@if (SignInManager.IsSignedIn(User) && showAdminGroup)
{
    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
       data-bs-toggle="collapse"
       href="#adminSubmenu"
       role="button"
       aria-expanded="false"
       aria-controls="adminSubmenu">
        <span><i class="bi bi-gear-fill"></i> @L["Role.Admin"]</span>
        <i class="bi bi-chevron-down small"></i>
    </a>

    <div class="collapse" id="adminSubmenu">

        @* Users (видим само при Users.View) *@
        @if (canViewUsers)
        {
            <a class="list-group-item list-group-item-action ps-4"
               asp-area="" asp-controller="Admin" asp-action="Users">
                <i class="bi bi-people-fill"></i> @L["Users"]
            </a>
        }

        @* Locomotives (видим само при Locomotives.View) *@
        @if (canViewLoco)
        {
            <a class="list-group-item list-group-item-action ps-4"
               asp-area="" asp-controller="Locomotive" asp-action="Index">
                <i class="bi bi-train-front-fill"></i> @L["Locomotives"]
            </a>
        }

        @* Roles & Permissions (видим само при Roles.View) *@
        @if (canViewRoles)
        {
            <a class="list-group-item list-group-item-action ps-4"
               asp-area="" asp-controller="Roles" asp-action="Index">
                <i class="bi bi-sliders"></i> @L["Roles_Permissions"].Value
            </a>
        }
    </div>
}

@* ===================== Work ===================== *@
<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
   data-bs-toggle="collapse"
   href="#workSubmenu"
   role="button"
   aria-expanded="false"
   aria-controls="workSubmenu">
    <span><i class="bi bi-activity"></i> @L["WorkSection"]</span>
    <i class="bi bi-chevron-down small"></i>
</a>

<div class="collapse ps-3" id="workSubmenu">
    <a class="list-group-item list-group-item-action ps-4"
       asp-area="" asp-controller="ShiftWork" asp-action="Index">
        @L["ShiftWork"]
    </a>
</div>

@* ===================== Repairs ===================== *@
<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
   data-bs-toggle="collapse"
   href="#repairSubmenu"
   role="button"
   aria-expanded="false"
   aria-controls="repairSubmenu">
    <span><i class="bi bi-tools"></i> @L["Repairs"]</span>
    <i class="bi bi-chevron-down small"></i>
</a>

<div class="collapse ps-3" id="repairSubmenu">
    <a class="list-group-item list-group-item-action ps-4"
       asp-area="" asp-controller="Repair" asp-action="Index">
        @L["PlanedRepairs"]
    </a>
</div>