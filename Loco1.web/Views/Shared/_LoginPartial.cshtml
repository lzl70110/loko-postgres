@using Microsoft.AspNetCore.Identity
@using Loco1.Data.Models
@using Loco1.Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="@L["Manage"]">
                @L["Welcome"], @User.Identity?.Name!
                </a>
            </li>

        @* Админ бутон за създаване на роли *@
        @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="CreateRole">
                    @L["AddRole"]
                    </a>
                </li>
            }

            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">@L["LoginButton"]</button>
                </form>
            </li>
        }
    else
        {
            <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@L["RegisterButton"]</a>
            </li>
            <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@L["LoginButton"]</a>
            </li>
        }
    </ul>