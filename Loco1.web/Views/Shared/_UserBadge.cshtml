@using Loco1.Data.Models
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    var userEntity = await UserManager.GetUserAsync(User);
    string role = "user";
    string badgeClass = "bg-primary"; // default User (blue)
    string email = "";

    if (userEntity != null)
        {
        var roles = await UserManager.GetRolesAsync(userEntity);

        if (roles.Contains("Owner"))
            {
            role = L["Role.Owner"];
            badgeClass = "bg-danger fw-bold fs-5";
            }
        else if (roles.Contains("Admin"))
            {
            role = L["Role.Admin"];
        badgeClass = "bg-success"; // green
            }
        else
            {
            role =L[ "User"];
            badgeClass = "bg-primary"; // blue
            }

        email = userEntity.Email ?? userEntity.UserName ?? "";
        }
    }

    <span class="badge @badgeClass me-2">
    @role
    </span>

    <span class="text-muted small">
    @email
    </span>