@using Loco1.Web.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loco1</title>

    <!-- Favicon (temporary emoji SVG) -->
    <link rel="icon" href="data:image/svg+xml,
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>
    <text y='.9em' font-size='90'>🚂</text>
    </svg>">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Loco1.web.styles.css" asp-append-version="true" />
    </head>

    <body>

    <!-- ================= HEADER ================= -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
                <div class="container-fluid">

                <!-- Brand (Left) -->
                    <a class="navbar-brand fw-bold text-primary"
                       asp-controller="Home"
                       asp-action="Index">
                    🚂 Loco1
                    </a>

                <!-- Right Side -->
                    <div class="ms-auto d-flex align-items-center">

                    @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="me-3">
                            <partial name="_UserBadge" />
                            </div>

                            <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index","Home")"
                              method="post"
                              class="me-3">
                                <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                @L["Logout"]
                                </button>
                            </form>
                        }
                    else
                        {
                            <a class="btn btn-sm btn-outline-primary me-2"
                               asp-area="Identity"
                               asp-page="/Account/Login">
                            @L["Login"]
                            </a>

                            <a class="btn btn-sm btn-primary me-3"
                               asp-area="Identity"
                               asp-page="/Account/Register">
                            @L["Register"]
                            </a>
                        }

                        <div>
                        @await Html.PartialAsync("_LanguageSwitcher")
                        </div>

                    </div>
                </div>
            </nav>
        </header>

    <!-- ================= STATUS MESSAGE ================= -->
    @if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show">
                @status
                    <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                    </button>
                </div>
            </div>
        }

    <!-- ================= MAIN CONTENT ================= -->
        <div class="container my-4">
            <div class="row">

            <!-- Sidebar -->
                <aside class="col-12 col-lg-3 mb-4">
                    <div class="card shadow-sm">
                        <div class="list-group list-group-flush">

                            <a class="list-group-item list-group-item-action"
                               asp-controller="Home"
                               asp-action="Index">
                            @L["Home"]
                            </a>

                            <a class="list-group-item list-group-item-action"
                               asp-controller="Home"
                               asp-action="Privacy">
                            @L["Privacy"]
                            </a>

                            @{
                            var adminEnabled =
                                Configuration.GetValue<bool?>("Features:Admin") ?? true;
                            }

                        @if (adminEnabled &&
                                                     SignInManager.IsSignedIn(User) &&
                                                     User.IsInRole("Admin"))
                            {
                                <div class="list-group-item text-uppercase small fw-semibold text-muted">
                                @L["Admin"]
                                </div>

                                <a class="list-group-item list-group-item-action"
                                   asp-controller="Admin"
                                   asp-action="Users">
                                @L["Users"]
                                </a>
                            }

                        </div>
                    </div>
                </aside>

            <!-- Page Body -->
                <main class="col-12 col-lg-9">
                @RenderBody()
                </main>

            </div>
        </div>

    <!-- ================= FOOTER ================= -->
        <footer class="border-top text-muted py-3 mt-4">
            <div class="container text-center small">

                <span class="rotator d-block">
                <span class="rotator__item">@L["Footer_R1"]</span>
                <span class="rotator__item">@L["Footer_R2"]</span>
                <span class="rotator__item">@L["Footer_R3"]</span>
                </span>

            </div>
        </footer>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    </body>
</html>