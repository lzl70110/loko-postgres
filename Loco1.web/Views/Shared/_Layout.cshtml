@using Loco1.Web.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IConfiguration Configuration


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loco1.web</title>

    <!-- CSS assets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Loco1.web.styles.css" asp-append-version="true" />
    </head>
    <body>
        <header>
        <!-- Top navigation bar -->
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Loco1.web</a>

                <!-- Hamburger (mobile) -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                    </button>

                <!-- Collapsible content -->
                    <div id="mainNavbar" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left side: top-level nav -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@L["Home"]</a>
                            </li>
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a>
                            </li>
                        </ul>

                    <!-- Right side: role/email badge, auth links, language switcher -->
                        <ul class="navbar-nav align-items-center">

                        @* If authenticated → show role/email badge and logout *@
                        @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item me-3">
                                <partial name="_UserBadge" /> @* Renders: owner/admin/user — email *@
                                </li>
                                <li class="nav-item">
                                    <form asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Action("Index","Home")"
                                      method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link p-0">@L["Logout"]</button>
                                    </form>
                                </li>
                            }
                        else
                            {
                                <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@L["Login"]</a>
                                </li>
                                <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@L["Register"]</a>
                                </li>
                            }

                        <!-- Language switcher (BG | EN) -->
                            <li class="nav-item ms-3">
                            @await Html.PartialAsync("_LanguageSwitcher")
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </header>

    <!-- Global TempData success message -->
    @if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
        {
            <div class="container mt-2">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                @status
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

    <!-- Two-column layout -->
        <div class="container my-4">
            <div class="row">
            <!-- Left column: navigation + Admin section -->
                <aside class="col-12 col-lg-3 mb-4">
                    <nav class="list-group">

                    <!-- Always visible -->
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Index">@L["Home"]</a>
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a>

                    @* Admin-only block (toggle via Features:Admin if needed) *@
                        @{
                        var adminEnabled = Configuration.GetValue<bool?>("Features:Admin") ?? true;
                        }
                    @if (adminEnabled && SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                        <div class="mt-3 fw-semibold small text-uppercase text-muted">@L["Admin"]</div>
                            <div class="list-group">
                            <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Admin" asp-action="Users">@L["Users"]</a>

                            @* Future admin modules:
                            <a class="list-group-item list-group-item-action disabled">@L["Locomotives"]</a>
                            <a class="list-group-item list-group-item-action disabled">@L["Fuels"]</a>
                            <a class="list-group-item list-group-item-action disabled">@L["Shift Works"]</a>
                            *@
                            </div>
                        }
                    </nav>
                </aside>

            <!-- Right column: page body -->
                <main class="col-12 col-lg-9" role="main">
                @RenderBody()
                </main>
            </div>
        </div>

    <!-- Footer -->
        <footer class="border-top footer text-muted">
            <div class="container">
            &copy; 2026 - Loco1.web -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a>
            </div>
        </footer>

    <!-- JS assets -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>