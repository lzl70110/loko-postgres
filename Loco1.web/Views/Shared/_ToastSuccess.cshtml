@* Renders a Bootstrap 5 toast when TempData["Success"] is set *@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L

@{
    // Read once; TempData survives a redirect.
    var success = TempData["Success"] as string;
    var showToast = !string.IsNullOrWhiteSpace(success);
}

@if (showToast)
{
    <div aria-live="polite" aria-atomic="true" class="position-relative">
        <!-- Toast container pinned to top-right -->
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
            <div id="appToastSuccess"
                 class="toast align-items-center text-bg-success border-0"
                 role="alert" aria-live="assertive" aria-atomic="true"
                 data-bs-delay="3500">
                <div class="d-flex">
                    <div class="toast-body">
                        @success
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-show toast on page load (after redirect)
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('appToastSuccess');
            if (el) {
                const t = new bootstrap.Toast(el);
                t.show();
            }
        });
    </script>
}
 