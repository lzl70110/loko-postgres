@using Microsoft.AspNetCore.Authorization
@using GCommon
@inject IAuthorizationService Auth
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@model IEnumerable<Loco1.ViewModels.Locomotives.LocoListVm>

@{
    ViewData["Title"] = L["Locomotives"].Value;

    // Rights checks for conditional buttons in Index
    var canDetails = (await Auth.AuthorizeAsync(User, Perm.Loco_View)).Succeeded;
    var canCreate = (await Auth.AuthorizeAsync(User, Perm.Loco_Add)).Succeeded;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (canCreate)
{
    <div class="mb-3">
        <!-- Create button is visible only if user has Loco_Add -->
        <a asp-controller="Locomotive" asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle"></i> @L["Common_Create"].Value
        </a>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">@L["NoLocomotivesAvailable"].Value</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Locomotive_Number"]</th>
                    @if (canDetails)
                    {
                        <th class="text-end">@L["Actions"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var loco in Model)
                {
                    <tr>
                        <!-- Show only the number to all authenticated users -->
                        <td class="fw-semibold">@loco.Number</td>

                        @if (canDetails)
                        {
                            <td class="text-end">
                                <!-- Details button is visible only if user has Loco_View -->
                                <a asp-controller="Locomotive" asp-action="Details" asp-route-id="@loco.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-sm-inline">@L["Details"]</span>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}