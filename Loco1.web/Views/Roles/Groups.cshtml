@model Loco1.ViewModels.Roles.RolePermVm

<h2>@L["Roles_Groups_Title"]: @Model.RoleName</h2>

<div class="list-group mt-3">
    @for (int i = 0; i < Model.Groups.Count; i++)
    {
        var g = Model.Groups[i];
        var url = Url.Action("EditGroup", "Roles", new { roleId = Model.RoleId, groupName = g.GroupName });

        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
           href="@url">
            <span>@L[g.GroupName]</span>
            <span class="badge text-bg-secondary">@L["Roles_Edit_Group_Short"]</span>
        </a>
    }
</div>

<div class="mt-3">
    <a class="btn btn-secondary" href="@Url.Action("Index", "Roles")">@L["Roles_Back"]</a>
</div>