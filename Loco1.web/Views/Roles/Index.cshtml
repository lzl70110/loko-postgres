@model IEnumerable<Loco1.ViewModels.Roles.RoleListItem>
@using Loco1.Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using GCommon
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth

@{
    // Check if current user can edit roles
    var canEditRoles = (await Auth.AuthorizeAsync(User, Perm.Roles_Edit)).Succeeded;
    ViewData["Title"] = L["Roles"].Value;
}

 
<h2 class="mb-3">@ViewData["Title"]</h2>

@if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @status
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@L["Role"].Value</th>
                <th class="text-end">@L["Actions"].Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Name</td>
                    <td class="text-end">
                        @if (canEditRoles)
                        {
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@r.Id">
                                <i class="bi bi-sliders"></i> @L["Permissions"]
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">@L["No access"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>