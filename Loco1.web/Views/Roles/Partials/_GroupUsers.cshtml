@model Loco1.ViewModels.Roles.PermGroupVm

@{
    var groupIndex = (int)(ViewData["GroupIndex"] ?? 0);
}

<div class="card mb-3">
    <div class="card-header">
        <strong>@L[Model.GroupName]</strong>
    </div>

    <div class="card-body">
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            var inputId = $"cb_{Model.GroupName}_{i}";

            <div class="form-check mb-1">
                <input class="form-check-input"
                       type="checkbox"
                       name="Groups[@groupIndex].Items[@i].Granted"
                       value="true"
                       id="@inputId"
                       @(item.Granted ? "checked" : "") />

                <label class="form-check-label" for="@inputId">
                    @L[item.Display]
                </label>

                <input type="hidden" name="Groups[@groupIndex].Items[@i].Code" value="@item.Code" />
                <input type="hidden" name="Groups[@groupIndex].Items[@i].Display" value="@item.Display" />
            </div>
        }
    </div>

    <input type="hidden" name="Groups[@groupIndex].GroupName" value="@Model.GroupName" />
</div>