
@using Loco1.Web.Resources
@using Loco1.Service
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model Loco1.ViewModels.EditUserRolesVm
@{
    ViewData["Title"] = L["Edit Roles"].Value;
    }

<h2>@L["Edit Roles"]</h2>
<p><strong>@L["User"]:</strong> @Model.Email</p>

<!-- English: proper form tag helper with method and antiforgery -->
    <form asp-controller="Admin" asp-action="EditRoles" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="UserId"
           type="hidden" />

        <div class="mb-3">
        <label class="form-label">@L["Roles"]</label>
            <div class="row">
            @if (Model.AvailableRoles?.Any() == true)
                {
                @foreach (var role in Model.AvailableRoles)
                    {
                    var isChecked = Model.SelectedRoles?.Contains(role) == true;

                        <div class="col-12 col-md-6 mb-2">
                            <div class="form-check">
                            <!-- English: bind to SelectedRoles (array-like) -->
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedRoles"
                                   value="@role"
                            @(isChecked ? "checked" : null) />
                            <label class="form-check-label">@L[role]</label>
                            </div>
                        </div>
                    }
                }
            else
                {
                    <div class="col-12">
                    <span class="text-muted">@L["No roles available"]</span>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Save"]</button>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">
            @L["Back"]
            </a>
        </div>
    </form>