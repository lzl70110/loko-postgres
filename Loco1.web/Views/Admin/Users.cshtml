@model List<Loco1.ViewModels.UserWithRolesVm>
@using Loco1.Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["Users"].Value;
    }

<h2>@L["Users"]</h2>

@if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
        @status
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="×"></button>
        </div>
    }

@if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
        @L["No users found."]
        </div>
    }
else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                <th>@L["Email"]</th>
                <th>@L["Roles"]</th>
                <th class="text-end" style="width: 260px;">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model)
                {
                var isDeleted = u.Email.StartsWith("deleted+");

                    <tr>
                    <td>@u.Email</td>

                        <td>
                        @if (u.Roles?.Any() == true)
                            {
                            @string.Join(", ", u.Roles.Select(r => L[r]))
                            }
                        else
                            {
                            <span class="text-muted">@L["No roles"]</span>
                            }
                        </td>

                        <td class="text-end">

                        <!-- Edit Roles -->
                            <a asp-controller="Admin"
                               asp-action="EditRoles"
                               asp-route-id="@u.Id"
                               class="btn btn-primary btn-sm me-2">
                            @L["Edit roles"]
                            </a>

                        @if (isDeleted)
                            {
                            <!-- Restore -->
                                <form asp-controller="Admin"
                                  asp-action="RestoreUser"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />

                                    <button type="submit"
                                        class="btn btn-info btn-sm"
                                        onclick="return confirm('@L["Restore this user?"]');">
                                    @L["Restore"]
                                    </button>
                                </form>
                            }
                        else
                            {
                            <!-- Deactivate -->
                                <form asp-controller="Admin"
                                  asp-action="DeactivateUser"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />

                                    <button type="submit"
                                        class="btn btn-warning btn-sm"
                                        onclick="return confirm('@L["Are you sure you want to deactivate this user?"]');">
                                    @L["Deactivate"]
                                    </button>
                                </form>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }