<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- NuGet packages needed by the service layer -->
	<ItemGroup>
		<!-- Identity (roles/users managers) -->
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.23" />
		<!-- EF Core base + relational provider (we query over DbContext here) -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.23" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.23" />
		<!-- Npgsql (match your versioning style) -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
		<!-- You already had this one; keep it if you really use IStringLocalizer in the service -->
		<PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.23" />
	</ItemGroup>

	<!-- Project references used by services -->
	<ItemGroup>
		<ProjectReference Include="..\Loco1.Data\Loco1.Data.csproj" />
		<ProjectReference Include="..\Loco1.Localizer\Loco1.Localizer.csproj" />
		<ProjectReference Include="..\Loco1.Repositories\Loco1.Repositories.csproj" />
		<ProjectReference Include="..\Loco1.ViewModels\Loco1.ViewModels.csproj" />
		<ProjectReference Include="..\GCommon\GCommon.csproj" />
	</ItemGroup>

</Project>